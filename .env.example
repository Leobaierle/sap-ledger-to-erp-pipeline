# Postgres com o schema `contabil` (portal/sql/*.sql). Sem DATABASE_URL o conversor usa os CSVs de app/dados/.
DATABASE_URL=postgresql://contabil_app:senha@localhost:5432/postgres
# SAP (RFC, somente leitura) — sap/sap_rfc.py
SAP_ASHOST=
SAP_SYSNR=00
SAP_CLIENT=
SAP_USER=
SAP_PASSWD=
SAP_BUKRS=1000
# API do ERP (leitura e gravação de lotes) — sap/erp.py
ERP_TOKEN=
# MinIO para guardar os arquivos de cada execução — app/arquivos.py
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Portal: JWT emitido pelo gateway de login (Microsoft Entra)
JWT_SECRET=
AUTH_GATEWAY=https://api.example.com
